# Godot editor cache (regenerated on open)
.godot/
*.translation

# Python
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
*.tmp

# Kilo Code local plans / scratch (user-local, not part of the repo)
.kilo/plans/

# Godot auto-import sidecars on non-game-texture rasters: the data/ map
# rasters are loaded via load_png_from_buffer (no import pipeline, 90-* §9),
# the contact sheet and engine fixtures are tool artifacts — never imported
# (Phase-10 master reconciliation, 2026-11-04).
/data/maps/*.import
/tools/contact_sheet.png.import
/tools/yoyopixel/**/*.import

# thenoise/ComfyUI raw model output — never committed (90-* §9.2)
tools/ui_art/model_raw/

# skin-sweep review captures: engine-import sidecars on review rasters are
# tool artifacts, never committed (same rule as /tools/contact_sheet.png.import)
/art_review/*.import
