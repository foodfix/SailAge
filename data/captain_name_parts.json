  "officer_bios": {
    "pilot": [
      {"zh": "自{n}出海的领航员,星图与洋流志从不离手。", "en": "A pilot out of {n}, never far from star charts and current tables."},
      {"zh": "在{n}的船上学了十年观星,如今终于有了自己的海图桌。", "en": "Ten years learning the stars aboard {n} ships, and a chart table finally his own."},
      {"zh": "{n}港口里出了名的夜航好手,雾里也不迷向。", "en": "The night-sailing toast of {n}'s harbor, never lost even in fog."}
    ],
    "boatswain": [
      {"zh": "嗓门最大的水手长,缆索在他手里从不打错一个结。", "en": "The loudest boatswain afloat; not one rope fouls under his knots."},
      {"zh": "在{n}的甲板上熬了半辈子,风暴天反而睡得更香。", "en": "Half a life on {n} decks; he sleeps soundest in a storm."},
      {"zh": "鞭子早就收起来了,可水手们还是不敢在他的甲板上偷懒。", "en": "The rattan is long retired, yet none dawdle on his deck."}
    ],
    "gunner": [
      {"zh": "装药永远亲手量的炮手,齐射前不看任何人脸色。", "en": "A gunner who measures every charge himself and asks no one's leave before the salvo."},
      {"zh": "{n}炮术行会的老会员,最恨受潮的火药。", "en": "A senior of {n}'s gunners' guild; nothing riles him like damp powder."},
      {"zh": "打靶比打牌还在行的炮长,赌桌上却输多赢少。", "en": "Better at targets than cards, and it shows at the betting table."}
    ],
    "surgeon": [
      {"zh": "缝合利落、用药大胆的船医,水手们叫他最后一道保险。", "en": "A deft, daring ship surgeon the crew calls the last line of safety."},
      {"zh": "在{n}的医馆学徒出身,坏血病名单上从没有他的船。", "en": "Trained in {n}'s infirmary; no ship of his ever makes the scurvy lists."},
      {"zh": "药箱比钱包鼓的船医,治好过半条街的热病。", "en": "A surgeon whose kit outweighs his purse, who has fevers of a whole street beaten."}
    ],
    "carpenter": [
      {"zh": "修龙骨像修钟表的匠人,一根钉也不肯多用。", "en": "A craftsman who trues a keel like a clockmaker and wastes not one nail."},
      {"zh": "{n}船坞里学徒第一名的修造师,手上的茧比图纸还厚。", "en": "First apprentice of {n}'s yards, with calluses thicker than his plans."},
      {"zh": "海上一面补帆一面补船板的巧手,脾气好得出奇。", "en": "Deft hands that patch sail and plank together at sea, and a temper sweet as honey."}
    ],
    "cook": [
      {"zh": "咸牛肉也能做出花样的厨师,锅里永远有下一勺。", "en": "A cook who makes salt beef a delicacy; the pot always has one more ladle."},
      {"zh": "在{n}的酒馆里学艺的厨子,淡水上手,咸风也难不倒。", "en": "Trained in {n}'s taverns; fresh water or salt wind, nothing spoils his pot."},
      {"zh": "嘴上不肯多话,却总给病号多盛一碗。", "en": "Few words, but the sick always get the bigger bowl."}
    ],
    "captain": [
      {"zh": "带过三条船的老船长,决斗场上从未输过。", "en": "An old captain of three hulls, never once beaten in the dueling yard."},
      {"zh": "{n}海军里退役的船长,令行禁止,赏罚分明。", "en": "A captain retired from {n}'s navy; orders kept, rewards exact."},
      {"zh": "商人出身的船长,更信算术胜过火药。", "en": "A captain out of the countinghouse who trusts arithmetic over powder."},
      {"zh": "从桅顶瞭望一路升上来的船长,眼力比望远镜还利。", "en": "A captain who climbed up from the masthead, with eyes sharper than any glass."}
    ]
  }
}
